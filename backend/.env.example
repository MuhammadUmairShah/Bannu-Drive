# =====================================================================
# Bannu Drive backend. Copy to .env (local) or set these in your host's dashboard (Render/Railway).
# NEVER commit the real .env. Rotate any secret that has ever been shared.
# =====================================================================

NODE_ENV=development            # set to "production" on the live server
PORT=5005

# ---- Database ----
MONGO_URI=mongodb+srv://USER:PASSWORD@CLUSTER.mongodb.net/bannu-drive

# ---- Auth ----
# At least 32 random characters. Generate: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
ACCESS_TOKEN_MINUTES=15         # optional (default 15)
REFRESH_TOKEN_DAYS=30           # optional (default 30)

# ---- Frontend / CORS / cookies ----
CLIENT_URL=http://localhost:5173            # exact frontend origin(s), no trailing slash
ALLOWED_ORIGINS=                            # optional extra origins, comma separated
# Frontend and API on DIFFERENT domains (vercel.app + onrender.com): leave both empty (SameSite=None; Secure).
# On the SAME parent domain (app.bannudrive.pk + api.bannudrive.pk) this is more robust:
#   COOKIE_DOMAIN=.bannudrive.pk   COOKIE_SAMESITE=lax
COOKIE_DOMAIN=
COOKIE_SAMESITE=

# ---- Google sign-in (Google Cloud Console -> Credentials -> OAuth client ID, type "Web application") ----
# Only the CLIENT ID is needed: the browser sends a Google ID token and the backend verifies it.
# There is no client secret in this flow, so nothing secret is ever put in the frontend.
GOOGLE_CLIENT_ID=

# ---- Private document storage (verification documents are stored as Cloudinary "authenticated" files) ----
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# ---- Verification policy ----
# true  = admin cannot mark a driver/operator verified unless their documents are approved (default in production)
# false = admin may verify manually (default in development, handy for demo accounts)
REQUIRE_DOCUMENTS_FOR_VERIFICATION=

# ---- Email (password reset); see shared/utils/mailer.js ----
# SMTP_HOST=
# SMTP_PORT=
# SMTP_USER=
# SMTP_PASS=
# MAIL_FROM=

# ---- Admin bootstrap (only read by `npm run create-admin`; remove from the host afterwards) ----
# ADMIN_NAME=
# ADMIN_EMAIL=
# ADMIN_PHONE=
# ADMIN_PASSWORD=

# ---- Optional rate-limit overrides (requests per window) ----
# LOGIN_RATE_LIMIT=20  REGISTER_RATE_LIMIT=20  GOOGLE_RATE_LIMIT=30  REFRESH_RATE_LIMIT=120
# PASSWORD_RATE_LIMIT=10  BOOKING_RATE_LIMIT=20  REQUEST_RATE_LIMIT=30  PAYMENT_RATE_LIMIT=30
# UPLOAD_RATE_LIMIT=30  QR_RATE_LIMIT=90  ADMIN_RATE_LIMIT=300

# ---- Misc ----
# DISABLE_DNS_OVERRIDE=true     # stop forcing 8.8.8.8/1.1.1.1 for Atlas SRV lookups
